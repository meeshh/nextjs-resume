{
  "name": "michel-barakat-resume",
  "license": "MIT",
  "version": "5.0.0",
  "type": "module",
  "private": true,
  "author": {
    "name": "Michel Barakat"
  },
  "keywords": [
    "resume",
    "generator",
    "nextjs",
    "pdf",
    "openai",
    "rate-limit"
  ],
  "homepage": "https://github.com/meeshh/nextjs-resume",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build",
    "build:content": "contentlayer2 build",
    "content:watch": "contentlayer2 dev",
    "dev": "next dev -p 3001",
    "format": "prettier --write 'src/**/*.{json,js,ts,tsx,css}'",
    "lint": "eslint .",
    "prebuild": "contentlayer2 build",
    "predev": "contentlayer2 build",
    "prepare": "husky",
    "pretest": "contentlayer2 build",
    "pretypes": "contentlayer2 build",
    "start": "next start -p 3001",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:update": "bun test --update-snapshots",
    "test:watch": "bun test --watch",
    "types": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@next/third-parties": "16.4.6",
    "@radix-ui/colors": "3.0.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "2.119.0",
    "@upstash/redis": "1.41.0",
    "class-variance-authority": "0.7.1",
    "contentlayer2": "0.5.8",
    "next": "16.4.6",
    "openai": "7.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "react-pdf-html": "2.1.5",
    "server-only": "0.0.1",
    "slugify": "1.6.9",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
